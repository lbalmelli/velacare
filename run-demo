#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/.venv"

if [[ ! -f "$VENV/.velacare-installed" ]]; then
  python3 -m venv "$VENV"
  "$VENV/bin/python" -m pip install --disable-pip-version-check --require-hashes -r "$ROOT/requirements.lock"
  "$VENV/bin/python" -m pip install --disable-pip-version-check --no-deps -e "$ROOT"
  touch "$VENV/.velacare-installed"
fi

exec "$VENV/bin/python" -m velacare.cli "$@"
